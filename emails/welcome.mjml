<mjml>
  <mj-head>
    <mj-font
      name="DM Sans"
      href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,100..1000;1,9..40,100..1000"
    />

    <mj-font
      name="Fraunces"
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,100..900;1,9..144,100..900&display=swap"
    />

    <mj-style inline="inline">
      .card-image img {
        display: block !important;
        margin: 0 auto !important;
      }

      .step-number {
        margin: 0;
        font-family: Fraunces, serif;
        font-size: 34px;
        font-style: italic;
        color: #ff693e;
        font-weight: 600;
        line-height: 34px;
      }

      .step-title {
        margin: 0 0 8px 0;
        font-family: "DM Sans", sans-serif;
        font-size: 17px;
        font-weight: 600;
        color: #3a3a3a;
        line-height: 100%;
      }
    </mj-style>

    <mj-attributes>
      <mj-text
        font-family="DM Sans, sans-serif"
        align="center"
        font-size="15px"
        line-height="24px"
        color="#555550"
        padding="0px"
      />

      <mj-image padding="0px" />

      <mj-button
        background-color="#FF693E"
        font-size="14px"
        color="#EEEEEE"
        font-family="DM Sans, sans-serif"
        text-transform="capitalize"
        border-radius="28px"
        inner-padding="16px 24px"
      />

      <mj-section padding="0px" />
      <mj-class
        name="head-text"
        font-size="64px"
        line-height="57.6px"
        font-weight="600"
      />
    </mj-attributes>
  </mj-head>

  <mj-body background-color="#F4F4F2">
    <!-- LOGO -->
    <mj-section padding-top="50px" padding-bottom="32px">
      <mj-column>
        <mj-raw>
          <table align="center"> <tr> <td><img width="22.5px" src="{{
            logo_url
          }}" alt="Logo" /></td> <td> <span style=" font-family: 'DM Sans',
          Arial, sans-serif; font-size: 19.25px; font-weight: 600; color:
          #242424; " > Social Badge </span> </td> </tr> </table>
        </mj-raw>
      </mj-column>
    </mj-section>

    <!-- CARD WRAPPER -->
    <mj-wrapper
      background-color="#FFFFFF"
      border-radius="24px"
      border="1px solid #EAEAE6"
      padding="0px"
    >
      <!-- WELCOME TEXT -->
      <mj-section padding="40px 64px 0px 64px">
        <mj-column>
          <mj-text color="#FF693E" font-size="11px" padding-bottom="16px">
            - WELCOME
          </mj-text>
        </mj-column>
      </mj-section>

      <!-- CARD IMAGE -->
      <mj-section padding="0px">
        <mj-column padding-bottom="40px">
          <mj-image
            src="{{welcome_image_url}}"
            alt="Welcome"
            width="358px"
            align="center"
            padding="0px"
            fluid-on-mobile="true"
            css-class="card-image"
          />
        </mj-column>
      </mj-section>

      <!-- HEADER -->
      <mj-section padding="0px 100px 0px 100px">
        <mj-column>
          <mj-text
            mj-class="head-text"
            font-family="Fraunces"
            font-weight="600"
          >
            You're In.</mj-text
          >
          <mj-text
            mj-class="head-text"
            font-family="Fraunces"
            font-style="italic"
            color="#FF693E"
            padding-bottom="16px"
            >let's ship.</mj-text
          >
          <mj-text>
            Your account is live. From here, it takes about three minutes to put
            a branded badge in front of your attendees. Here's the
            route.</mj-text
          >
        </mj-column>
      </mj-section>

      <!-- CTA BUTTON -->
      <mj-section>
        <mj-column padding-top="24px" padding-bottom="32px">
          <mj-button href="{{cta_link}}">
            Build Your First Badge&nbsp;&nbsp;↗
          </mj-button>
        </mj-column>
      </mj-section>

      <!-- Pointer section -->
      <mj-section padding="0 64px 43px 64px">
        <mj-column>
          <mj-raw>
            <table role="presentation" cellpadding="0" cellspacing="0"
            border="0" width="100%" style="margin-bottom: 24px; border-top: 1px
            solid #eaeae6;" > <tr> <td style=" vertical-align: top;
            padding-right: 20px; padding-top: 32px; " > <p
            class="step-number">01</p> </td> <td style="vertical-align: top;
            padding-top: 32px;"> <p class="step-title">Pick a template</p> <p
            style=" margin: 0; font-family: 'DM Sans', Arial, sans-serif;
            font-size: 15px; line-height: 24px; color: #525252; " > Four
            pre-built layouts. Swap colors, drop your logo, you're 80% there.
            </p> </td> </tr> </table> <table role="presentation" cellpadding="0"
            cellspacing="0" border="0" width="100%" style="margin-bottom: 24px;"
            > <tr> <td style=" vertical-align: top; padding-right: 20px; " > <p
            class="step-number">02</p> </td> <td style="vertical-align: top;">
            <p class="step-title">Set the caption + link</p> <p style=" margin:
            0; font-family: 'DM Sans', Arial, sans-serif; font-size: 15px;
            line-height: 24px; color: #525252; " > Write the share text once.
            UTMs get appended automatically. Every share is traceable. </p>
            </td> </tr> </table> <table role="presentation" cellpadding="0"
            cellspacing="0" border="0" width="100%" style=" margin-bottom: 24px;
            border-bottom: 1px solid #eaeae6; " > <tr> <td style="
            vertical-align: top; padding-right: 20px; padding-bottom: 32px; " >
            <p class="step-number">03</p> </td> <td style=" vertical-align: top;
            padding-bottom: 32px; " > <p class="step-title"> Publish &amp; share
            the link </p> <p style=" margin: 0; font-family: 'DM Sans', Arial,
            sans-serif; font-size: 15px; line-height: 24px; color: #525252; " >
            Drop it in your confirmation emails or paste it anywhere. Watch the
            dashboard fill up. </p> </td> </tr> </table> <!-- STUCK? TEXT -->
            <table role="presentation" cellpadding="0" cellspacing="0"
            border="0" width="100%" > <tr> <td style=" font-family: 'DM Sans',
            Arial, sans-serif; font-size: 12px; line-height: 24px; color:
            #555550; text-align: center; " > Stuck? Reply to this email — it
            lands in our inbox, a human reads it. Or browse the <a href="{{
              explore_page_url
            }}" style=" color: #3a3a3a; text-decoration: underline; " > Explore
            Page </a> for inspiration from organizers who've already shipped.
            </td> </tr> </table>
          </mj-raw>
        </mj-column>
      </mj-section>
    </mj-wrapper>

    <!-- FOOTER -->
    <mj-section padding-top="32px">
      <mj-column>
        <mj-text font-size="12px" color="#8A8A85">
          Need help?
          <a
            href="mailto:{{support_email}}"
            style="color: #3a3a3a; text-decoration: underline"
            >{{ support_email }}</a
          >
        </mj-text>

        <mj-text
          font-size="11px"
          line-height="18px"
          color="#9B9B9B"
          align="center"
          padding="0px"
        >
          © 2026
          <a
            href="{{homepage_url}}"
            style="color: #9b9b9b; text-decoration: underline"
          >
            BADGE.BUILD
          </a>

          &nbsp; · &nbsp;

          <a
            href="{{privacy_url}}"
            style="color: #9b9b9b; text-decoration: underline"
          >
            PRIVACY
          </a>

          &nbsp; · &nbsp;

          <a
            href="{{terms_url}}"
            style="color: #9b9b9b; text-decoration: underline"
          >
            TERMS
          </a>
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
